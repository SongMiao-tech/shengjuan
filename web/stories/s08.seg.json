 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3456,
   "text": "夜幕降临，星星们亮晶晶。"
  },
  {
   "idx": 1,
   "start_ms": 4256,
   "dur_ms": 3864,
   "text": "小星星眨巴眼，找不到妈妈。"
  },
  {
   "idx": 2,
   "start_ms": 8920,
   "dur_ms": 3648,
   "text": "月亮姐姐，月亮姐姐，你在哪里？"
  },
  {
   "idx": 3,
   "start_ms": 13368,
   "dur_ms": 3888,
   "text": "月亮姐姐笑眯眯，告诉我方向。"
  },
  {
   "idx": 4,
   "start_ms": 18056,
   "dur_ms": 4272,
   "text": "小星星，小星星，快快回家去。"
  },
  {
   "idx": 5,
   "start_ms": 23128,
   "dur_ms": 4032,
   "text": "小星星，小星星，飞呀飞呀飞。"
  },
  {
   "idx": 6,
   "start_ms": 27960,
   "dur_ms": 3648,
   "text": "妈妈在，妈妈在，温暖的家。"
  },
  {
   "idx": 7,
   "start_ms": 32408,
   "dur_ms": 3240,
   "text": "晚安，小星星，做个好梦。"
  }
 ]
}