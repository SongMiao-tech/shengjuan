{
 "story_id": "s02",
 "audio": "audio/s02.mp3",
 "duration_s": 62.6,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3480,
   "text": "夜幕降临，\n小刺猬还在玩。"
  },
  {
   "idx": 1,
   "start_ms": 4280,
   "dur_ms": 4824,
   "text": "“哎呀，困了！”\n小刺猬揉揉眼。"
  },
  {
   "idx": 2,
   "start_ms": 9904,
   "dur_ms": 3864,
   "text": "“小刺猬，快睡吧。”\n妈妈轻声说。"
  },
  {
   "idx": 3,
   "start_ms": 14568,
   "dur_ms": 5064,
   "text": "“不，我还不想睡。”\n小刺猬打了个大哈欠。"
  },
  {
   "idx": 4,
   "start_ms": 20432,
   "dur_ms": 4848,
   "text": "“哎呀，我也想睡了。”\n小鸟在树上叫。"
  },
  {
   "idx": 5,
   "start_ms": 26080,
   "dur_ms": 4056,
   "text": "“我也想睡了。”\n小兔子躲进洞里。"
  },
  {
   "idx": 6,
   "start_ms": 30936,
   "dur_ms": 5904,
   "text": "“大家快睡吧，小刺猬。”\n森林里的动物都跟着打哈欠。"
  },
  {
   "idx": 7,
   "start_ms": 37640,
   "dur_ms": 5064,
   "text": "“好吧，大家晚安。”\n小刺猬慢慢闭上眼。"
  },
  {
   "idx": 8,
   "start_ms": 43504,
   "dur_ms": 9264,
   "text": "“晚安，小刺猬。”\n妈妈轻拍着小刺猬，\n小刺猬甜甜地笑了，\n慢慢地，慢慢地，\n进入了梦乡。"
  },
  {
   "idx": 9,
   "start_ms": 53568,
   "dur_ms": 7656,
   "text": "小刺猬睡得香香的，\n森林里静悄悄的，\n大家都进入了甜美的梦乡。"
  }
 ]
}