{
 "story_id": "s12",
 "audio": "audio/s12.mp3",
 "duration_s": 48.8,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3240,
   "text": "夜幕降临，月亮升上了天空。"
  },
  {
   "idx": 1,
   "start_ms": 4040,
   "dur_ms": 4656,
   "text": "小猴子们在河边玩耍，看见水中的月亮。"
  },
  {
   "idx": 2,
   "start_ms": 9495,
   "dur_ms": 5448,
   "text": "「哇，月亮掉进水里了！」小猴子们惊叫。"
  },
  {
   "idx": 3,
   "start_ms": 15744,
   "dur_ms": 2040,
   "text": "「我们来捞月亮吧！」"
  },
  {
   "idx": 4,
   "start_ms": 18584,
   "dur_ms": 4032,
   "text": "小猴子们跳进水里，用手去捞。"
  },
  {
   "idx": 5,
   "start_ms": 23416,
   "dur_ms": 4032,
   "text": "「哎呀，月亮怎么捞不起来呢？」"
  },
  {
   "idx": 6,
   "start_ms": 28248,
   "dur_ms": 3072,
   "text": "小猴子们失望地回到岸边。"
  },
  {
   "idx": 7,
   "start_ms": 32120,
   "dur_ms": 3648,
   "text": "「月亮在水里，影子捞不起。」"
  },
  {
   "idx": 8,
   "start_ms": 36568,
   "dur_ms": 3240,
   "text": "小猴子们明白了，笑了。"
  },
  {
   "idx": 9,
   "start_ms": 40608,
   "dur_ms": 2280,
   "text": "「我们回家睡觉吧。」"
  },
  {
   "idx": 10,
   "start_ms": 43688,
   "dur_ms": 3648,
   "text": "小猴子们手拉手，回家去了。"
  }
 ]
}