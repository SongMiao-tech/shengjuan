{
 "story_id": "s14",
 "audio": "audio/s14.mp3",
 "duration_s": 83.9,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3864,
   "text": "安静的小村庄，阳光洒在石头上。"
  },
  {
   "idx": 1,
   "start_ms": 4664,
   "dur_ms": 4032,
   "text": "“石头汤，真神奇！”小兔子说。"
  },
  {
   "idx": 2,
   "start_ms": 9495,
   "dur_ms": 3840,
   "text": "“是的，我们来试试吧。”小猫点头。"
  },
  {
   "idx": 3,
   "start_ms": 14136,
   "dur_ms": 4848,
   "text": "小兔子从篮子里拿出几块石头，放进锅里。"
  },
  {
   "idx": 4,
   "start_ms": 19784,
   "dur_ms": 2688,
   "text": "“咕咚咕咚”，水开了。"
  },
  {
   "idx": 5,
   "start_ms": 23272,
   "dur_ms": 3072,
   "text": "小猫从罐子里舀了一勺盐。"
  },
  {
   "idx": 6,
   "start_ms": 27144,
   "dur_ms": 3072,
   "text": "“咝~”，盐融化了。"
  },
  {
   "idx": 7,
   "start_ms": 31016,
   "dur_ms": 3648,
   "text": "小狗跑来，从花园里摘了朵花。"
  },
  {
   "idx": 8,
   "start_ms": 35464,
   "dur_ms": 3624,
   "text": "“哇，花真香！”大家说。"
  },
  {
   "idx": 9,
   "start_ms": 39888,
   "dur_ms": 2832,
   "text": "小猪从溪边提来了水。"
  },
  {
   "idx": 10,
   "start_ms": 43519,
   "dur_ms": 3216,
   "text": "“哗啦哗啦”，水注入锅里。"
  },
  {
   "idx": 11,
   "start_ms": 47535,
   "dur_ms": 3072,
   "text": "小鸭子从湖里带来了荷叶。"
  },
  {
   "idx": 12,
   "start_ms": 51407,
   "dur_ms": 2664,
   "text": "“荷叶飘香”，大家夸。"
  },
  {
   "idx": 13,
   "start_ms": 54871,
   "dur_ms": 2856,
   "text": "小牛从草原上带了草。"
  },
  {
   "idx": 14,
   "start_ms": 58527,
   "dur_ms": 2856,
   "text": "“绿油油的”，大家笑。"
  },
  {
   "idx": 15,
   "start_ms": 62183,
   "dur_ms": 4272,
   "text": "最后，小猴子从树上摘了几个果子。"
  },
  {
   "idx": 16,
   "start_ms": 67255,
   "dur_ms": 3240,
   "text": "“咝~”，果子裂开了。"
  },
  {
   "idx": 17,
   "start_ms": 71295,
   "dur_ms": 4032,
   "text": "“石头汤，真美味！”大家欢呼。"
  },
  {
   "idx": 18,
   "start_ms": 76127,
   "dur_ms": 5856,
   "text": "夜晚，星星点点的天空，大家躺在草地上，安静入睡。"
  }
 ]
}