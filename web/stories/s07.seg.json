 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3864,
   "text": "静静的夜晚，\n小鸭子小声哭。"
  },
  {
   "idx": 1,
   "start_ms": 4664,
   "dur_ms": 3864,
   "text": "“我好害怕过桥呀！”\n小鸭子说。"
  },
  {
   "idx": 2,
   "start_ms": 9328,
   "dur_ms": 3240,
   "text": "“别怕，我陪你。”\n小猫说。"
  },
  {
   "idx": 3,
   "start_ms": 13367,
   "dur_ms": 3480,
   "text": "“我也要来！”\n小狗也来了。"
  },
  {
   "idx": 4,
   "start_ms": 17648,
   "dur_ms": 3240,
   "text": "鸭子们手牵手，\n一步步走。"
  },
  {
   "idx": 5,
   "start_ms": 21688,
   "dur_ms": 3456,
   "text": "“看，彩虹桥多美！”\n小猫说。"
  },
  {
   "idx": 6,
   "start_ms": 25944,
   "dur_ms": 4272,
   "text": "“是的，我们是最勇敢的朋友！”\n小狗说。"
  },
  {
   "idx": 7,
   "start_ms": 31016,
   "dur_ms": 3240,
   "text": "小鸭子笑了，\n“谢谢你们！”"
  },
  {
   "idx": 8,
   "start_ms": 35056,
   "dur_ms": 3864,
   "text": "桥上星星闪，\n小鸭子们入睡。"
  },
  {
   "idx": 9,
   "start_ms": 39720,
   "dur_ms": 3480,
   "text": "梦里彩虹桥，\n温暖又安宁。"
  }
 ]
}