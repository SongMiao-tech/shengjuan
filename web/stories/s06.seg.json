{
 "story_id": "s06",
 "audio": "audio/s06.mp3",
 "duration_s": 66.6,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 2856,
   "text": "小猪躺在泥巴堆里"
  },
  {
   "idx": 1,
   "start_ms": 3655,
   "dur_ms": 3240,
   "text": "“呀呼呼，洗澡太麻烦！”"
  },
  {
   "idx": 2,
   "start_ms": 7696,
   "dur_ms": 3456,
   "text": "小猪的朋友们躲得远远的"
  },
  {
   "idx": 3,
   "start_ms": 11952,
   "dur_ms": 2256,
   "text": "“臭死了，小猪！”"
  },
  {
   "idx": 4,
   "start_ms": 15008,
   "dur_ms": 2664,
   "text": "小猪难过地哭了"
  },
  {
   "idx": 5,
   "start_ms": 18472,
   "dur_ms": 2256,
   "text": "“我不想洗澡！”"
  },
  {
   "idx": 6,
   "start_ms": 21528,
   "dur_ms": 5064,
   "text": "第二天，小猪看到自己变成了脏兮兮的小黑猪"
  },
  {
   "idx": 7,
   "start_ms": 27392,
   "dur_ms": 3072,
   "text": "“呀呼呼，好难受！”"
  },
  {
   "idx": 8,
   "start_ms": 31264,
   "dur_ms": 2832,
   "text": "小猪终于决定洗澡了"
  },
  {
   "idx": 9,
   "start_ms": 34896,
   "dur_ms": 2664,
   "text": "“哗啦啦，真舒服！”"
  },
  {
   "idx": 10,
   "start_ms": 38360,
   "dur_ms": 2856,
   "text": "朋友们又回到小猪身边"
  },
  {
   "idx": 11,
   "start_ms": 42016,
   "dur_ms": 2448,
   "text": "“小猪，你好香！”"
  },
  {
   "idx": 12,
   "start_ms": 45263,
   "dur_ms": 2424,
   "text": "小猪开心地笑了"
  },
  {
   "idx": 13,
   "start_ms": 48488,
   "dur_ms": 2040,
   "text": "“我们一起洗澡吧！”"
  },
  {
   "idx": 14,
   "start_ms": 51328,
   "dur_ms": 3240,
   "text": "小猪们一起洗得干干净净"
  },
  {
   "idx": 15,
   "start_ms": 55368,
   "dur_ms": 2832,
   "text": "“呀呼呼，好快乐！”"
  },
  {
   "idx": 16,
   "start_ms": 59000,
   "dur_ms": 3072,
   "text": "夜晚，小猪们安静入睡"
  },
  {
   "idx": 17,
   "start_ms": 62872,
   "dur_ms": 1872,
   "text": "“晚安，好梦。”"
  }
 ]
}