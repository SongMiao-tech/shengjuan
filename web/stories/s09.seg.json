{
 "story_id": "s09",
 "audio": "audio/s09.mp3",
 "duration_s": 77.3,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 2040,
   "text": "安静的小镇上，"
  },
  {
   "idx": 1,
   "start_ms": 2840,
   "dur_ms": 3240,
   "text": "小兔子和乌龟约好赛跑。"
  },
  {
   "idx": 2,
   "start_ms": 6880,
   "dur_ms": 3072,
   "text": "“我跑得快！”兔子骄傲地说。"
  },
  {
   "idx": 3,
   "start_ms": 10751,
   "dur_ms": 4032,
   "text": "“我会慢慢来。”乌龟微笑着回答。"
  },
  {
   "idx": 4,
   "start_ms": 15584,
   "dur_ms": 1632,
   "text": "比赛开始了，"
  },
  {
   "idx": 5,
   "start_ms": 18016,
   "dur_ms": 4032,
   "text": "兔子飞快地跑，乌龟慢慢地爬。"
  },
  {
   "idx": 6,
   "start_ms": 22848,
   "dur_ms": 4056,
   "text": "“哈哈，我领先了！”兔子高兴地笑。"
  },
  {
   "idx": 7,
   "start_ms": 27704,
   "dur_ms": 2448,
   "text": "乌龟却一直坚持，"
  },
  {
   "idx": 8,
   "start_ms": 30952,
   "dur_ms": 2664,
   "text": "一步一步，不放弃。"
  },
  {
   "idx": 9,
   "start_ms": 34416,
   "dur_ms": 3072,
   "text": "兔子累了，停下来休息。"
  },
  {
   "idx": 10,
   "start_ms": 38288,
   "dur_ms": 2424,
   "text": "乌龟却继续前进，"
  },
  {
   "idx": 11,
   "start_ms": 41512,
   "dur_ms": 3072,
   "text": "不急不躁，慢慢接近终点。"
  },
  {
   "idx": 12,
   "start_ms": 45384,
   "dur_ms": 2856,
   "text": "“我赢了！”乌龟开心地说。"
  },
  {
   "idx": 13,
   "start_ms": 49040,
   "dur_ms": 1632,
   "text": "兔子跑过来，"
  },
  {
   "idx": 14,
   "start_ms": 51472,
   "dur_ms": 1632,
   "text": "“我学到了，"
  },
  {
   "idx": 15,
   "start_ms": 53904,
   "dur_ms": 1872,
   "text": "坚持很重要。”"
  },
  {
   "idx": 16,
   "start_ms": 56576,
   "dur_ms": 1848,
   "text": "他们成了好朋友，"
  },
  {
   "idx": 17,
   "start_ms": 59224,
   "dur_ms": 2856,
   "text": "一起玩耍，一起成长。"
  },
  {
   "idx": 18,
   "start_ms": 62880,
   "dur_ms": 1632,
   "text": "晚安，宝贝，"
  },
  {
   "idx": 19,
   "start_ms": 65312,
   "dur_ms": 2040,
   "text": "愿你像乌龟一样，"
  },
  {
   "idx": 20,
   "start_ms": 68152,
   "dur_ms": 2664,
   "text": "坚持梦想，不放弃。"
  },
  {
   "idx": 21,
   "start_ms": 71616,
   "dur_ms": 1248,
   "text": "入睡吧，"
  },
  {
   "idx": 22,
   "start_ms": 73664,
   "dur_ms": 1464,
   "text": "做个好梦。"
  }
 ]
}