{
 "story_id": "s11",
 "audio": "audio/s11.mp3",
 "duration_s": 61.2,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3648,
   "text": "安静的小河边，小马低头喝水。"
  },
  {
   "idx": 1,
   "start_ms": 4448,
   "dur_ms": 2832,
   "text": "“妈妈，我要过河。”"
  },
  {
   "idx": 2,
   "start_ms": 8080,
   "dur_ms": 2256,
   "text": "“河里水多深？”"
  },
  {
   "idx": 3,
   "start_ms": 11136,
   "dur_ms": 2256,
   "text": "“不知道，我要试试。”"
  },
  {
   "idx": 4,
   "start_ms": 14192,
   "dur_ms": 3072,
   "text": "小马迈开步，慢慢走。"
  },
  {
   "idx": 5,
   "start_ms": 18064,
   "dur_ms": 3240,
   "text": "“哗啦哗啦，水好凉啊！”"
  },
  {
   "idx": 6,
   "start_ms": 22104,
   "dur_ms": 3456,
   "text": "小马小心地走，一步一步。"
  },
  {
   "idx": 7,
   "start_ms": 26360,
   "dur_ms": 3240,
   "text": "“哇，水好深啊！”"
  },
  {
   "idx": 8,
   "start_ms": 30400,
   "dur_ms": 2856,
   "text": "小马回头，想回家。"
  },
  {
   "idx": 9,
   "start_ms": 34056,
   "dur_ms": 2040,
   "text": "“不，我要勇敢。”"
  },
  {
   "idx": 10,
   "start_ms": 36896,
   "dur_ms": 3072,
   "text": "小马又走，一步一回头。"
  },
  {
   "idx": 11,
   "start_ms": 40768,
   "dur_ms": 3072,
   "text": "“哗啦哗啦，水声好响。”"
  },
  {
   "idx": 12,
   "start_ms": 44640,
   "dur_ms": 3072,
   "text": "小马继续走，越来越稳。"
  },
  {
   "idx": 13,
   "start_ms": 48512,
   "dur_ms": 1464,
   "text": "“我做到了！”"
  },
  {
   "idx": 14,
   "start_ms": 50776,
   "dur_ms": 3240,
   "text": "小马开心地笑，跳上对岸。"
  },
  {
   "idx": 15,
   "start_ms": 54816,
   "dur_ms": 1872,
   "text": "“晚安，小马。”"
  },
  {
   "idx": 16,
   "start_ms": 57488,
   "dur_ms": 1848,
   "text": "“晚安，世界。”"
  }
 ]
}