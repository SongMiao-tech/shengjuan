{
 "story_id": "s10",
 "audio": "audio/s10.mp3",
 "duration_s": 57.9,
 "segments": [
  {
   "idx": 0,
   "start_ms": 0,
   "dur_ms": 3648,
   "text": "夜幕降临，月亮悄悄升起。"
  },
  {
   "idx": 1,
   "start_ms": 4448,
   "dur_ms": 4032,
   "text": "小兔子在菜园里发现了一个大萝卜。"
  },
  {
   "idx": 2,
   "start_ms": 9280,
   "dur_ms": 3240,
   "text": "“哎呀，这个萝卜真大啊！”"
  },
  {
   "idx": 3,
   "start_ms": 13320,
   "dur_ms": 4248,
   "text": "小兔子想：\n“我要怎么拔出这个大萝卜呢？”"
  },
  {
   "idx": 4,
   "start_ms": 18368,
   "dur_ms": 3864,
   "text": "小兔子喊：“谁来帮我拔萝卜呀？”"
  },
  {
   "idx": 5,
   "start_ms": 23032,
   "dur_ms": 3072,
   "text": "小松鼠跑过来：“我来帮忙！”"
  },
  {
   "idx": 6,
   "start_ms": 26904,
   "dur_ms": 3240,
   "text": "小猪也来了：“我也来！”"
  },
  {
   "idx": 7,
   "start_ms": 30944,
   "dur_ms": 4656,
   "text": "小兔子、小松鼠和小猪一起用力拔。"
  },
  {
   "idx": 8,
   "start_ms": 36400,
   "dur_ms": 2040,
   "text": "“嘿呦！嘿呦！”"
  },
  {
   "idx": 9,
   "start_ms": 39240,
   "dur_ms": 2856,
   "text": "大萝卜终于拔出来了！"
  },
  {
   "idx": 10,
   "start_ms": 42896,
   "dur_ms": 1632,
   "text": "“我们成功了！”"
  },
  {
   "idx": 11,
   "start_ms": 45328,
   "dur_ms": 4680,
   "text": "小兔子、小松鼠和小猪开心地笑了。"
  },
  {
   "idx": 12,
   "start_ms": 50808,
   "dur_ms": 2832,
   "text": "他们一起把大萝卜抬回家。"
  },
  {
   "idx": 13,
   "start_ms": 54440,
   "dur_ms": 1872,
   "text": "“晚安，好梦。”"
  }
 ]
}